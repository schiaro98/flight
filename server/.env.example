# Duffel API key — get it from https://app.duffel.com/developers/access-tokens
# Use a test token (duffel_test_...) for development
DUFFEL_API_KEY=duffel_test_your_key_here

# Port for the backend server (default: 3001)
PORT=3001

# Frontend URL for CORS (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173
